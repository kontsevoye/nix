+func TestRuntimeHealthTmuxUIBudget(t *testing.T) {
+	health.ResetStatusPassBreachState()
+	h := &Home{width: 100}
+	for _, tc := range []struct {
+		sessions int
+		calls    int64
+		warn     bool
+	}{
+		{0, 39, false},
+		{1, 64, false},
+		{8, 39, false}, // the reported live spike is within budget
+		{8, 65, false}, // first and second breaches stay quiet
+		{8, 65, false},
+		{8, 65, true}, // sustained excess is still visible
+		{8, 65, true},
+		{8, 64, false}, // recovery clears the warning and the streak
+		{8, 65, false},
+		{8, 64, false},
+		{8, 65, false},  // isolated spikes never build a streak
+		{10, 80, false}, // budget scales with larger decks
+		{10, 81, false},
+		{10, 81, false},
+		{10, 81, true},
+		{10, 8, false},
+	} {
+		h.queueHealthWarning(30*time.Millisecond, tc.sessions, tc.calls)
+		h.consumeHealthWarning()
+		got := strings.TrimSpace(h.renderHealthWarning()) != ""
+		if got != tc.warn {
+			t.Fatalf("sessions=%d calls=%d: warning=%q", tc.sessions, tc.calls, h.renderHealthWarning())
+		}
+	}
+}
+
+func TestRuntimeHealthTmuxBreachIsPerHome(t *testing.T) {
+	health.ResetStatusPassBreachState()
+	first, second := &Home{width: 100}, &Home{width: 100}
+	first.queueHealthWarning(30*time.Millisecond, 1, 100)
+	first.queueHealthWarning(30*time.Millisecond, 1, 100)
+	second.queueHealthWarning(30*time.Millisecond, 1, 100)
+	second.consumeHealthWarning()
+	if got := second.renderHealthWarning(); got != "" {
+		t.Fatalf("another Home's breaches affected this warning: %q", got)
+	}
+	first.queueHealthWarning(30*time.Millisecond, 1, 100)
+	first.consumeHealthWarning()
+	if !strings.Contains(first.renderHealthWarning(), "tmux calls") {
+		t.Fatal("warning absent after three breaches")
+	}
+}
+
+func TestRuntimeHealthLatencyWarningTakesPriority(t *testing.T) {
+	health.ResetStatusPassBreachState()
+	h := &Home{width: 100}
+	for range 3 {
+		h.queueHealthWarning(300*time.Millisecond, 1, 100)
+	}
+	h.consumeHealthWarning()
+	if !strings.Contains(h.renderHealthWarning(), "status pass exceeds 250 ms") {
+		t.Fatalf("latency warning was lost: %q", h.renderHealthWarning())
+	}
+}
