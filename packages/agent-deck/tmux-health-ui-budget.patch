--- a/internal/ui/runtime_health.go
+++ b/internal/ui/runtime_health.go
@@ -1,6 +1,7 @@
 package ui
 
 import (
+	"fmt"
 	"time"
 
 	"github.com/asheshgoplani/agent-deck/internal/health"
@@ -10,7 +11,14 @@
 // The status worker queues its latest verdict (possibly "" to signal recovery);
 // only the UI goroutine mutates footer state.
 func (h *Home) queueHealthWarning(elapsed time.Duration, sessions int, calls int64) {
-	warning := health.BudgetWarning(elapsed, sessions, calls)
+	// Calls are process-wide, so embedded terminals and background work can
+	// overlap a status pass. Use a more generous UI budget for small decks;
+	// keep the strict developer budget in `agent-deck health` unchanged.
+	warning := health.BudgetWarning(elapsed, sessions, 0)
+	callBudget := max(16, 4*sessions)
+	if warning == "" && calls > int64(callBudget) {
+		warning = fmt.Sprintf("Health: tmux calls %d exceed UI budget %d", calls, callBudget)
+	}
 	h.healthWarningPending.Store(&warning)
 }
 
--- a/internal/ui/runtime_health_test.go
+++ b/internal/ui/runtime_health_test.go
@@ -69,3 +69,28 @@
 		t.Fatal("health warning did not clear after recovery")
 	}
 }
+
+func TestRuntimeHealthTmuxUIBudget(t *testing.T) {
+	health.ResetStatusPassBreachState()
+	h := &Home{width: 100}
+	for _, tc := range []struct {
+		sessions int
+		calls    int64
+		warn     bool
+	}{
+		{0, 4, false},
+		{1, 10, false},
+		{3, 16, false},
+		{3, 17, true},
+		{10, 40, false},
+		{10, 41, true},
+		{3, 4, false}, // recovery clears a previous warning
+	} {
+		h.queueHealthWarning(30*time.Millisecond, tc.sessions, tc.calls)
+		h.consumeHealthWarning()
+		got := strings.TrimSpace(h.renderHealthWarning()) != ""
+		if got != tc.warn {
+			t.Fatalf("sessions=%d calls=%d: warning=%q", tc.sessions, tc.calls, h.renderHealthWarning())
+		}
+	}
+}
